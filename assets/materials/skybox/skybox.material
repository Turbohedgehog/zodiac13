material skybox/skybox
{
    technique
    {
        pass
        {
            lighting off
            depth_write off

            cull_hardware none
            cull_software none

            // Текстурный юнит
            texture_unit
            {
                // cubic_texture - для 6 отдельных изображений
                // cubic_texture textures/skybox/skybox1.jpg textures/skybox/skybox1.jpg textures/skybox/skybox1.jpg textures/skybox/skybox1.jpg textures/skybox/skybox1.jpg textures/skybox/skybox1.jpg combinedUVW
                // cubic_texture skybox1.jpg combinedUVW
                
                // ИЛИ texture - для DDS файла с кубической картой
                texture textures/skybox/vz_techno_cubemap_ue.dds cubic
                
                // Фильтрация текстур
                // filtering anisotropic
                // max_anisotropy 8
                // tex_address_mode clamp
            }
        }
    }
}
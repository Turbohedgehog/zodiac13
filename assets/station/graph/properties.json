{
  "version": 1,
  "node": {
    "height": {
      "type": "int",
      "title": "Room height",
      "unit": "cells",
      "min": 12,
      "max": 40,
      "default": 14
    },
    "ceiling": {
      "type": "bool",
      "title": "Ceiling",
      "default": true
    },
    "lamp": {
      "type": "bool",
      "title": "Lamp",
      "default": true
    },
    "spawn": {
      "type": "bool",
      "title": "Spawn points",
      "default": false
    }
  },
  "edge": {
    "kind": {
      "type": "enum",
      "title": "Kind",
      "values": [
        "Door",
        "Passage",
        "Window"
      ],
      "default": "Door"
    },
    "width": {
      "type": "int",
      "title": "Opening width",
      "unit": "cells",
      "min": 4,
      "max": 24,
      "default": 6
    }
  }
}

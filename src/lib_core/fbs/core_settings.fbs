include "attributes.fbs";

// What lib_core tunes: the tick rate, the snapshot history and the rollback loop.

namespace z13.fbs.core;

table CoreSettings {
  fps: double = 60 (min: 1, max: 1000, cli: "-f,--fps");
  snapshot_interval_seconds: double = 1 (min: "0.001", cli);
  snapshot_retention_seconds: double = 5 (min: "0.001", cli);

  // A larger wall-clock backlog is a hitch: dropped, not replayed in a burst.
  max_tick_backlog: uint64 = 15 (min: 1, cli);
  max_deferred_rollbacks: uint32 = 16 (min: 1, cli);
  max_rollback_delay_ticks: uint64 = 6 (cli);
  // Safety bound, not a scheduler: a corrupt target tick spreads over calls.
  max_catch_up_ticks_per_frame: uint64 = 1024 (min: 1, max: 65536, cli);
}

root_type CoreSettings;

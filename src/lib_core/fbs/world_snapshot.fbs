// WorldSnapshot (lib_core/world_serializer.h) on the wire and on disk.

namespace z13.fbs.state;

table ComponentValue {
  type: string (shared);   // component full path
  value: [ubyte]; // EncodeValue bytes (lib_core/component_codec.h)
}

// A table, not a bare string: only a string field can be (shared).
table Tag {
  name: string (shared);
}

table Relationship {
  relation: string (shared);
  target: string (shared);
}

table EntitySnapshot {
  name: string;
  tags: [Tag];
  components: [ComponentValue];
  relationships: [Relationship];
}

table WorldSnapshot {
  entities: [EntitySnapshot];
}

root_type WorldSnapshot;

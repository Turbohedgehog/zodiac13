// WorldSnapshot (lib_core/world_serializer.h) on the wire and on disk. Component values
// are still flecs meta JSON; binary values are the next step (docs/serialization-plan.md).

namespace z13.fbs.state;

table ComponentValue {
  type: string;   // component full path
  value: string;  // flecs meta JSON
}

table Relationship {
  relation: string;
  target: string;
}

table EntitySnapshot {
  name: string;
  tags: [string];
  components: [ComponentValue];
  relationships: [Relationship];
}

table WorldSnapshot {
  entities: [EntitySnapshot];
}

root_type WorldSnapshot;

#pragma once

#include <string_view>

namespace z13 {

// The project's full version (major.minor.patch, from version.txt) and CI's suffix naming a
// non-release build ("-pr12"). Purely informational (e.g. embedded in save files for debugging
// which build produced them) -- not a compatibility gate for any file format.
constexpr std::string_view kEngineVersion = "@Z13_FULL_VERSION@@Z13_VERSION_SUFFIX@";
// UTC, YYYY-MM-DD: the day CI built it, or a local build configured.
constexpr std::string_view kBuildDate = "@Z13_BUILD_DATE@";

}  // namespace z13

include "common.fbs";

namespace z13.fbs.conduit;

// assets/station/conduits.json.
table ConduitKind {
  id: uint32;
  name: string;
  network: string;
  thickness_cells: float = 0.25;
  // Red, green, blue, alpha; 0..255 each.
  color: [ubyte];
}

table ConduitKinds {
  kinds: [ConduitKind];
}

// Active while a conduit tool is in the hand.
enum Action : int16 (action, action_group: "Conduit") {
  // The first click starts a run at the aimed cell, the second lays it up to the aimed cell along the longest axis.
  LAY_CONDUIT (display_text: "Lay a conduit", default_keycodes: "MOUSE_BUTTON_LEFT TOUCH_PRIMARY"),
  // Removes the aimed run; with a run in the making, drops it instead.
  REMOVE_CONDUIT (display_text: "Remove a conduit", default_keycodes: "MOUSE_BUTTON_RIGHT TOUCH_DESTROY"),
  PREVIOUS_CONDUIT_KIND (display_text: "Previous conduit", default_keycodes: "KEY_Q TOUCH_PREVIOUS_PRIMITIVE"),
  NEXT_CONDUIT_KIND (display_text: "Next conduit", default_keycodes: "KEY_E TOUCH_NEXT_PRIMITIVE"),
  // Into the aimed wall or floor, or on its surface.
  TOGGLE_CONDUIT_DEPTH (display_text: "Inside or on the surface", default_keycodes: "KEY_V TOUCH_TOOL_MODE"),
}

root_type ConduitKinds;

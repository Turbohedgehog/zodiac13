// Client-server wire protocol (docs/client-server-plan.md). Structs below are
// fixed-size wire records; tables carry the variable-length envelope around them.
// Session/command logic (handshake, scheduling, rollback) lands in later branches --
// this schema exists now so the transport/codec layer has real messages to move.

include "net_tuning.fbs";
include "physics_tuning.fbs";
include "building_tuning.fbs";
include "world_snapshot.fbs";

namespace z13.fbs.net;

// 6 bytes (padded). `tick_delta` is relative to a batch's own base_tick (see CommandBatch /
// SequencedCommands); `value` is quantized (see player_action.h's QuantizeActionValue).
struct CommandWire {
  tick_delta: ubyte;
  action_id: ushort;
  value: short;
}

struct CommandMove {
  from_tick: ulong;
  to_tick: ulong;
  action_id: ushort;
  value: short;
}

// Where StateDigest's players stand, to log who diverged -- not a pose-sync message (movement
// goes through commands, see the plan's "Модель синхронизации").
struct PoseWire {
  player_id: uint;
  x: float;
  y: float;
  z: float;
}

// One sector's share of StateDigest.state_hash's snapshot (docs/interest-design.md).
struct SectorHashWire {
  x: int;
  y: int;
  z: int;
  hash: ulong;
}

// 16 bytes (padded).
struct PlayerTickWire {
  player_id: uint;
  tick: ulong;
}

// 24 bytes (padded): a PlayerActionRecord with its absolute tick and player, for the
// catch-up lists, which span several players and an arbitrary window of ticks.
struct ActionRecordWire {
  tick: ulong;
  player_id: uint;
  action_id: uint;
  value: float;
}

// An action by its stable name; ids are local to each side until the server assigns them.
table ActionDesc {
  enum_name: string;
  value_name: string;
  enum_value: long;
}

table ClientHello {
  version: uint;
  actions: [ActionDesc];  // every action the client has, in its own order
  palette_hash: ulong = null;  // the station block palette's, if loaded
}

table CommandBatch {
  base_tick: ulong;  // already apply_tick, not the client's raw local tick
  commands: [CommandWire];
  through_tick: ulong;  // the sender's commands up to this tick are all in this batch or earlier ones
}

table ResyncRequest {
  // The tick whose digest differed; null after a failed rollback.
  diverged_tick: ulong = null;
}

table Ping {
  client_tick: ulong;
}

table Pong {
  client_tick: ulong;
  server_tick: ulong;
}

// What a client needs to reach the server's present: Welcome and Resync carry it.
table CatchUp {
  server_tick: ulong;
  // Reused from WorldSnapshotHistory's periodic capture rather than a fresh one taken
  // for this join; snapshot_tick lets the client replay forward to server_tick below.
  snapshot: z13.fbs.state.WorldSnapshot;  // state only
  snapshot_tick: ulong;
  actions: [ActionRecordWire];  // (snapshot_tick, server_tick]
  held_values: [ActionRecordWire];  // currently-held (player_id, action_id) -> value, tick == snapshot_tick
  pending: [ActionRecordWire];  // already-scheduled commands with apply_tick > server_tick
  // ConfirmedInputTicks at server_tick: past it a player's input reads as released, as on the server.
  input_through: [PlayerTickWire];
}

table Welcome {
  player_id: uint;
  catch_up: CatchUp;
  action_ids: [uint];  // the server's id for each ClientHello.actions entry, same order
  // The client runs on these instead of its own: peers must tick alike.
  fps: double;
  tuning: NetTuning;
  physics: z13.fbs.physics.PhysicsTuning;
  building: z13.fbs.building.BuildingTuning;
}

table Rejected {
  reason: string;
}

// The client already has its id and settings.
table Resync {
  catch_up: CatchUp;
}

table PlayerJoined {
  apply_tick: ulong;
  entity_state: z13.fbs.state.WorldSnapshot;  // the joining player's entity only
}

table PlayerLeft {
  apply_tick: ulong;
  player_id: uint;
}

table SequencedCommands {
  player_id: uint;
  base_tick: ulong;  // already apply_tick
  commands: [CommandWire];
  through_tick: ulong;  // as in CommandBatch
}

// To the sender only: the others get the moved commands in SequencedCommands.
table CommandsRetimed {
  moves: [CommandMove];
}

table StateDigest {
  tick: ulong;
  entity_count: uint;
  name_hash: ulong;
  // HashSnapshot of the tick's snapshot: what the digests are compared by.
  state_hash: ulong;
  // The same snapshot by sector, plus what lies in none; sorted by sector.
  global_hash: ulong;
  sector_hashes: [SectorHashWire];
  positions: [PoseWire];
  // Per player, the tick their input is final through (ConfirmedInputTicks): past it, released.
  input_through: [PlayerTickWire];
  // Per player, the tick through which the server had received their own input (a client's
  // CommandBatch.through_tick), so a client doesn't compare a tick its unsent input may still move.
  received_through: [PlayerTickWire];
}

union MessageBody {
  ClientHello, CommandBatch, ResyncRequest, Ping, Pong,
  Welcome, Rejected, Resync, PlayerJoined, PlayerLeft, SequencedCommands, StateDigest, CommandsRetimed,
}

table MessageEnvelope {
  body: MessageBody;
}

root_type MessageEnvelope;

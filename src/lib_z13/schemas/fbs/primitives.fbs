// The station's block palette (assets/station/palette.json); see
// docs/station-primitives-plan.md. Sizes are in grid cells, X×Y×Z with Z up.

namespace z13.fbs.station;

struct Cells {
  x: ushort;
  y: ushort;
  z: ushort;
}

struct Rgba {
  r: ubyte;
  g: ubyte;
  b: ubyte;
  a: ubyte;
}

// A full cuboid.
table Box {}

// Slope rising along +X: full bottom, full face at the far X end. The run (X) may be from
// one to `max_run_per_rise` times the rise (Z).
table Wedge {
  max_run_per_rise: ubyte = 1;
}

// The outer corner of two wedges: full bottom, apex above the far X/Y corner.
table CornerWedge {}

// A frame around a centered opening at the bottom, filled by a closed door leaf.
table DoorFrame {
  opening_width: ushort;
  opening_height: ushort;
}

// A parallelogram prism: the section in the XZ plane runs from the bottom-left corner up
// along (X, slant) over the whole X, with a vertical thickness of Z - slant, and is extended
// along Y. A wall of any direction in the plane is one panel.
table Panel {}

union Shape { Box, Wedge, CornerWedge, DoorFrame, Panel }

enum PrimitiveFlags : uint (bit_flags) {
  Solid,
  GasSealing,
  Transparent,
  Hidden,
  Climbable,
  Spawn,
  // A switch: using it turns it on or off.
  Switch,
  // A door's leaf: closed, it seals the opening without blocking a body.
  Door,
}

// How players may interact with a block of the primitive (docs/station-systems-plan.md, "Взаимодействие").
enum InteractionMethods : ubyte (bit_flags) {
  Use,
  Hold,
  Presence,
}

table Interaction {
  methods: InteractionMethods;
  // Presence only: how far beyond the block, along every axis, its sensor reaches.
  sensor_cells: ushort;
}

// Two-color checker with one square per grid cell.
table Checker {
  first: Rgba;
  second: Rgba;
  // Drawn at full color whatever lights it, as a lamp glows.
  emissive: bool = false;
  // A tile in assets/textures/station/ (without its extension), one per meter by the world
  // position; the checker colors are what a preview without the texture shows.
  texture: string;
}

// A point light just below the primitive's bottom face (its own -Z), reaching `radius_cells`.
table LightSource {
  color: Rgba;
  radius_cells: ushort;
  intensity: float = 1;
}

// How a block of the primitive joins a utility network (docs/station-systems-plan.md, "Модули и коммуникации").
// The core keeps the strings and numbers; the module of the network checks `role`, `priority` and the value names.
table PortValue {
  name: string;
  value: long;
}

table Port {
  network: string;
  role: string;
  priority: string;
  // Numbers only the network's module reads: power takes `demand` and `capacity`.
  values: [PortValue];
}

table Primitive {
  // Stable: block state stores it, so reordering the palette keeps saves valid.
  id: uint;
  name: string;
  // A few letters for where the name doesn't fit (the brush row); the name's capitals when empty.
  short_name: string;
  shape: Shape;
  // Equal for a fixed-size primitive; a stretchable one spans this range.
  min_size: Cells;
  max_size: Cells;
  material: Checker;
  flags: PrimitiveFlags;
  light: LightSource;
  // The share of a lamp's light a Transparent primitive lets through (cell_light); others block it.
  light_transmission: float = 1;
  interaction: Interaction;
  ports: [Port];
}

table Palette {
  // Largest extent of a primitive along any axis (64 m at 0.25 m cells).
  max_size_cells: ushort = 256;
  primitives: [Primitive];
}

root_type Palette;

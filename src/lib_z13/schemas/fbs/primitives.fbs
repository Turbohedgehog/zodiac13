// The station's block palette (assets/station/palette.json); see
// docs/station-primitives-plan.md. Sizes are in grid cells, X×Y×Z with Z up.

namespace z13.fbs.station;

struct Cells {
  x: ushort;
  y: ushort;
  z: ushort;
}

struct Rgba {
  r: ubyte;
  g: ubyte;
  b: ubyte;
  a: ubyte;
}

// A full cuboid.
table Box {}

// Slope rising along +X: full bottom, full face at the far X end.
table Wedge {}

// The outer corner of two wedges: full bottom, apex above the far X/Y corner.
table CornerWedge {}

// A frame around a centered opening at the bottom, filled by a closed door leaf.
table DoorFrame {
  opening_width: ushort;
  opening_height: ushort;
}

union Shape { Box, Wedge, CornerWedge, DoorFrame }

enum PrimitiveFlags : uint (bit_flags) {
  Solid,
  GasSealing,
  Transparent,
  Hidden,
  Climbable,
  Spawn,
}

// Two-color checker with one square per grid cell.
table Checker {
  first: Rgba;
  second: Rgba;
}

table Primitive {
  // Stable: block state stores it, so reordering the palette keeps saves valid.
  id: uint;
  name: string;
  shape: Shape;
  // Equal for a fixed-size primitive; a stretchable one spans this range.
  min_size: Cells;
  max_size: Cells;
  material: Checker;
  flags: PrimitiveFlags;
}

table Palette {
  primitives: [Primitive];
}

root_type Palette;

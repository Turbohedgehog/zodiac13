// The "physics" table of settings.json, also what a server sends in Welcome.

include "attributes.fbs";

namespace z13.fbs.physics;

table PhysicsTuning {
  player_collider_radius: float = 0.4 (min: "0.01", cli);
  // Slide steps per collider sweep: a corner (two faces) needs two.
  max_sweep_iterations: uint32 = 3 (min: 1, max: 16, cli);
}

// Client-server wire protocol (docs/client-server-plan.md). Structs below are
// fixed-size wire records; tables carry the variable-length envelope around them.
// Session/command logic (handshake, scheduling, rollback) lands in later branches --
// this schema exists now so the transport/codec layer has real messages to move.

include "net_tuning.fbs";
include "physics_tuning.fbs";
include "world_snapshot.fbs";

namespace z13.fbs.net;

// 6 bytes (padded). `tick_delta` is relative to a batch's own base_tick (see CommandBatch /
// SequencedCommands); `value` is quantized (see player_action.h's QuantizeActionValue).
struct CommandWire {
  tick_delta: ubyte;
  action_id: ushort;
  value: short;
}

// Only for StateDigest's coarse position check -- not a pose-sync message (movement
// goes through commands, see the plan's "Модель синхронизации"). Position-specific by
// design for now (epsilon tolerance absorbs cross-platform FP drift, see the plan's
// "Кросс-платформенный детерминизм"); TODO generalize to other modules' state once a
// real need shows up -- a hash-based digest can't offer the same tolerance.
struct PoseWire {
  player_id: uint;
  x: float;
  y: float;
  z: float;
}

// 24 bytes (padded): a PlayerActionRecord with its absolute tick and player, for the
// catch-up lists, which span several players and an arbitrary window of ticks.
struct ActionRecordWire {
  tick: ulong;
  player_id: uint;
  action_id: uint;
  value: float;
}

// An action by its stable name; ids are local to each side until the server assigns them.
table ActionDesc {
  enum_name: string;
  value_name: string;
  enum_value: long;
}

table ClientHello {
  version: uint;
  actions: [ActionDesc];  // every action the client has, in its own order
}

table CommandBatch {
  base_tick: ulong;  // already apply_tick, not the client's raw local tick
  commands: [CommandWire];
  through_tick: ulong;  // the sender's commands up to this tick are all in this batch or earlier ones
}

table ResyncRequest {}

table Ping {
  client_tick: ulong;
}

table Pong {
  client_tick: ulong;
  server_tick: ulong;
}

table Welcome {
  player_id: uint;
  server_tick: ulong;
  // Reused from WorldSnapshotHistory's periodic capture rather than a fresh one taken
  // for this join; snapshot_tick lets the client replay forward to server_tick below.
  snapshot: z13.fbs.state.WorldSnapshot;  // state only
  snapshot_tick: ulong;
  actions: [ActionRecordWire];  // (snapshot_tick, server_tick]
  held_values: [ActionRecordWire];  // currently-held (player_id, action_id) -> value, tick == snapshot_tick
  pending: [ActionRecordWire];  // already-scheduled commands with apply_tick > server_tick
  action_ids: [uint];  // the server's id for each ClientHello.actions entry, same order
  // The client runs on these instead of its own: peers must tick alike.
  fps: double;
  tuning: NetTuning;
  physics: z13.fbs.physics.PhysicsTuning;
}

table Rejected {
  reason: string;
}

// Welcome without the player id: the client already has one.
table Resync {
  server_tick: ulong;
  snapshot: z13.fbs.state.WorldSnapshot;
  snapshot_tick: ulong;
  actions: [ActionRecordWire];
  held_values: [ActionRecordWire];
  pending: [ActionRecordWire];
}

table PlayerJoined {
  apply_tick: ulong;
  entity_state: z13.fbs.state.WorldSnapshot;  // the joining player's entity only
}

table PlayerLeft {
  apply_tick: ulong;
  player_id: uint;
}

table SequencedCommands {
  player_id: uint;
  base_tick: ulong;  // already apply_tick
  commands: [CommandWire];
  through_tick: ulong;  // as in CommandBatch
}

table StateDigest {
  tick: ulong;
  entity_count: uint;
  name_hash: ulong;
  positions: [PoseWire];
}

union MessageBody {
  ClientHello, CommandBatch, ResyncRequest, Ping, Pong,
  Welcome, Rejected, Resync, PlayerJoined, PlayerLeft, SequencedCommands, StateDigest,
}

table MessageEnvelope {
  body: MessageBody;
}

root_type MessageEnvelope;

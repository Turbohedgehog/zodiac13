// The "power" table of settings.json, also what a server sends in Welcome.

include "attributes.fbs";

namespace z13.fbs.power;

table PowerTuning {
  // Networks balance once per this many ticks (10 Hz at 60 ticks per second); the tick picks the step, never the time.
  step_ticks: uint32 = 6 (min: 1, max: 600, cli);
}

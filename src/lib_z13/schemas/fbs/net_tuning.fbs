// The "net" table of settings.json, also what a server sends in Welcome.

include "attributes.fbs";

namespace z13.fbs.net;

// Who a hint of a class goes to (a class's tuning below, the action's `hint` attribute in common.fbs).
enum HintFilter : ubyte {
  None,  // nobody: the class is off
  All,
  Distance,  // the clients whose player is within the class's radius of the hinted player
}

table NetTuning {
  send_interval_ticks: uint64 = 3 (min: 1, cli);
  max_late_ticks: uint64 = 96 (cli);
  max_schedule_ahead_ticks: uint64 = 30 (cli);
  session_event_delay_ticks: uint64 = 12 (cli);
  rollback_snapshots_per_interval: uint64 = 4 (min: 1, cli);

  clock_offset_smoothing: double = 0.25 (min: "0.001", max: 1, cli);
  clock_catch_up_threshold_ticks: int64 = 2 (min: 1, cli);
  clock_catch_up_every_ticks: uint64 = 4 (min: 1, cli);
  clock_jump_threshold_ticks: int64 = 15 (min: 1, cli);
  // Ticks a client's clock runs ahead of the server's: about the trip of its commands plus send_interval_ticks, so
  // they arrive before their tick and don't roll the server back. The server's player sees the others this
  // much later, so a server with a player (listen) keeps it short.
  clock_lead_ticks: uint64 = 3 (cli);
  // The same for a dedicated server, which has no player to see the lead: enough for a trip of two ticks.
  dedicated_clock_lead_ticks: uint64 = 7 (cli);

  // Side of a sector, in cells: a multiple of building.index_chunk_cells, so a sector is whole snapshot chunk groups.
  sector_size_cells: int32 = 64 (min: 1, cli);
  // How far a client's interest reaches from its sector, in sectors: the inner ring is shown and checked, the margin
  // around it is simulated too so the inner ring's borders come out as on the server.
  interest_radius_sectors: int32 = 1 (min: 0, max: 4, cli);
  interest_margin_sectors: int32 = 1 (min: 0, max: 4, cli);
  // Each client holds the world within its interest only (docs/interest-design.md): it is told of the players and
  // sectors that enter or leave, gets a view in Welcome and Resync, and checks its digests in the inner ring. Off,
  // every client has the whole world.
  interest_events: bool = true (cli);

  // The hint class "look" (the angles of a player's view): sent every this many ticks.
  look_hint_interval_ticks: uint64 = 2 (min: 1, cli);
  look_hint_filter: HintFilter = Distance;
  look_hint_radius_m: double = 30 (min: 1, cli);
  // Beyond this distance only every look_hint_far_every-th hint of a player is sent to a client.
  look_hint_near_radius_m: double = 10 (min: 0, cli);
  look_hint_far_every: uint64 = 4 (min: 1, cli);
}

// The "door" table of settings.json, also what a server sends in Welcome.

include "attributes.fbs";

namespace z13.fbs.door;

table DoorTuning {
  // Ticks a powered door takes to open or close fully.
  open_ticks: uint32 = 30 (min: 1, max: 6000, cli);
  // Ticks a door takes by hand: unpowered, or set to manual (the crank).
  manual_open_ticks: uint32 = 180 (min: 1, max: 6000, cli);
  // Ticks an automatic door stays open after the last body left its sensor.
  close_delay_ticks: uint32 = 120 (min: 0, max: 6000, cli);
  // How far open a door must be, in thousandths, for its leaf to stop blocking bodies.
  passable_position: int32 = 700 (min: 0, max: 1000, cli);
}

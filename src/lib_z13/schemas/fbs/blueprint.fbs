// A ready-made station (assets/station/blueprints/), placed block by block; see
// docs/station-primitives-plan.md. Written by docs/station-layout/generate_layout.py.

include "primitives.fbs";

namespace z13.fbs.station;

struct Cell {
  x: int;
  y: int;
  z: int;
}

// z13::station::Orientation, in the same order.
enum Orientation : ubyte {
  FacePosXUpPosZ,
  FacePosXUpNegZ,
  FacePosXUpPosY,
  FacePosXUpNegY,
  FaceNegXUpPosZ,
  FaceNegXUpNegZ,
  FaceNegXUpPosY,
  FaceNegXUpNegY,
  FacePosYUpPosZ,
  FacePosYUpNegZ,
  FacePosYUpPosX,
  FacePosYUpNegX,
  FaceNegYUpPosZ,
  FaceNegYUpNegZ,
  FaceNegYUpPosX,
  FaceNegYUpNegX,
  FacePosZUpPosX,
  FacePosZUpNegX,
  FacePosZUpPosY,
  FacePosZUpNegY,
  FaceNegZUpPosX,
  FaceNegZUpNegX,
  FaceNegZUpPosY,
  FaceNegZUpNegY,
}

table BlueprintBlock {
  // The palette entry's name: ids may differ between palettes, names are what a blueprint
  // is checked against.
  primitive: string;
  // The lowest corner of the cells the block occupies.
  cell: Cell;
  size: Cells;
  orientation: Orientation;
}

table Blueprint {
  blocks: [BlueprintBlock];
}

root_type Blueprint;

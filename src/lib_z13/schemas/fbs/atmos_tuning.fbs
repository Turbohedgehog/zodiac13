// The "atmos" table of settings.json, also what a server sends in Welcome.

include "attributes.fbs";

namespace z13.fbs.atmos;

table AtmosTuning {
  // The air of the rooms is worked out once per this many ticks (10 Hz at 60 ticks per second).
  step_ticks: uint32 = 6 (min: 1, max: 600, cli: "--atmos-step-ticks");
  // How fast air goes through an opening (atmos/exchange.h): at 10000 a door into the vacuum takes about a quarter of
  // the air of a room of 1200 cells at a step.
  flow_coefficient: int32 = 10000 (min: 1, max: 100000, cli);
  // The most of a room's air, in millionths, that all its openings take at one step.
  max_outflow_ppm: int32 = 500000 (min: 1000, max: 1000000, cli);
  // An automatic door does not open for a body while the pressure on its two sides differs by more than this, in pascals.
  interlock_pascals: int32 = 20000 (min: 0, max: 200000, cli);
  // What a body in a room breathes at a step: oxygen taken and carbon dioxide given, in millimoles, and its heat, in
  // millijoules.
  breath_millimoles: int32 = 3 (min: 0, max: 1000, cli);
  body_heat_millijoules: int32 = 10000 (min: 0, max: 1000000, cli);
}

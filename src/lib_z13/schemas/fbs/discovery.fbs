// Finding servers on the LAN (docs/server-plan.md, "Поиск сервера"): a client broadcasts a
// query, each server answers it directly. Apart from the game protocol (net.fbs): it is read
// from anyone on the network, before any session.

namespace z13.fbs.discovery;

table DiscoveryQuery {
  // The discovery format's; a query of another is dropped unanswered.
  format_version: uint32;
  // The client's clock when sent, returned in the reply: the ping, with no state kept.
  sent_at_ms: uint64;
}

// A server's answer; the master server's list will reuse it.
table ServerInfo {
  sent_at_ms: uint64;
  name: string;
  // The game protocol's (net_module's kProtocolVersion): a server of another is shown, greyed.
  protocol_version: uint32;
  // The station blueprint; absent for the spaceship.
  scene: string;
  players: uint32;
  game_port: uint16;
  // Drawn once per server process: a server answering through several addresses is listed once.
  instance_id: uint64;
}

union DiscoveryBody { DiscoveryQuery, ServerInfo }

table DiscoveryMessage {
  body: DiscoveryBody;
}

root_type DiscoveryMessage;
file_identifier "Z13D";

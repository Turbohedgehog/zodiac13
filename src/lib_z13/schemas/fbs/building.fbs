include "common.fbs";
include "geometry.fbs";

namespace z13.fbs.building;

table Wall {}

union BlockContent {
  Wall
}

table Block {
  transform: z13.fbs.geometry.Transform;
  content: BlockContent;
}

enum Action : int16 (action, action_group: "Building") {
  // The tool mode's action: build, destroy, cut, cut in or a click of the wall.
  BUILD_BLOCK (display_text: "Use the build tool", default_keycodes: "MOUSE_BUTTON_LEFT TOUCH_PRIMARY"),
  // Destroys in any tool mode; with a wall or merge in the making, drops it instead.
  DESTROY_BLOK (display_text: "Destroy a block", default_keycodes: "MOUSE_BUTTON_RIGHT TOUCH_DESTROY"),
  PREVIOUS_PRIMITIVE (display_text: "Previous primitive", default_keycodes: "KEY_Q TOUCH_PREVIOUS_PRIMITIVE"),
  NEXT_PRIMITIVE (display_text: "Next primitive", default_keycodes: "KEY_E TOUCH_NEXT_PRIMITIVE"),
  // Held: the tool cuts the dragged box out of the station, whatever its mode.
  CUT_MODIFIER (display_text: "Cut instead of build", default_keycodes: "KEY_X"),
  // Held: the tool cuts the block's place out first, so it fits into a wall, whatever its mode.
  CUT_IN_MODIFIER (display_text: "Cut the place out first", default_keycodes: "KEY_LSHIFT"),
  // Held: the cursor is free and the palette window shows, to pick a primitive with the mouse.
  SHOW_PALETTE (display_text: "Show the block palette", default_keycodes: "KEY_B"),
  ROTATE_AROUND_Z (display_text: "Turn the brush around Z", default_keycodes: "KEY_R TOUCH_TURN_Z"),
  ROTATE_AROUND_Y (display_text: "Turn the brush around Y", default_keycodes: "KEY_F TOUCH_TURN_Y"),
  ROTATE_AROUND_X (display_text: "Turn the brush around X", default_keycodes: "KEY_G TOUCH_TURN_X"),
  CYCLE_TOOL_MODE (display_text: "Next build tool mode", default_keycodes: "KEY_V TOUCH_TOOL_MODE"),
  // Its value is the palette slot (from 1) picked in the palette window, for one frame.
  SELECT_PRIMITIVE (display_text: "Primitive from the palette window"),
  // Set for the frames the local player is paused mid-drag: the release that pausing
  // reads as must not place the block.
  CANCEL_BRUSH_DRAG (display_text: "Cancel the drag"),
}

// Active only in the Wall, Merge and Bridge modes: the wheel then sets the wall's thickness or
// steps the merge target, not the hotbar cell.
enum WallAction : int16 (action, action_group: "BuildingWall") {
  THICKER_WALL (display_text: "Thicker wall", default_keycodes: "MOUSE_WHEEL_UP TOUCH_THICKER TOUCH_MERGE_AT"),
  THINNER_WALL (display_text: "Thinner wall", default_keycodes: "MOUSE_WHEEL_DOWN TOUCH_THINNER"),
  // With a bridge or wall in the making: the bent wall takes the other diagonal.
  FLIP_DIAGONAL (display_text: "Flip the wall's diagonal", default_keycodes: "KEY_T TOUCH_FLIP_DIAGONAL"),
  // With a wall in the making: a fourth click sets the stick at its second node, so the wall bends.
  BEND_WALL (display_text: "Bend the wall", default_keycodes: "KEY_C TOUCH_BEND"),
}

root_type Block;
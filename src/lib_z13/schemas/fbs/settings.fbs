include "building_tuning.fbs";
include "core_settings.fbs";
include "net_tuning.fbs";
include "physics_tuning.fbs";

// The game's settings.json, next to the input config.

namespace z13.fbs.settings;

table ConnectTimeout {
  limit: uint32 = 32 (min: 1, cli: "--connect-limit");
  min_timeout_ms: uint32 = 1000 (min: 1, cli: "--connect-min-timeout-ms");
  max_timeout_ms: uint32 = 3000 (min: 1, cli: "--connect-max-timeout-ms");
}

// How remote entities are drawn chasing their simulated pose (client only, never sent).
table VisualSmoothing {
  smooth_time_seconds: float = 0.1 (min: 0, max: 2, cli: "--visual-smooth-time");
  // A correction past either limit (a teleport, a resync) is drawn at once.
  snap_distance: float = 20 (min: 0, cli: "--visual-snap-distance");
  snap_angle_deg: float = 90 (min: 0, max: 180, cli: "--visual-snap-angle");
}

// How the station is drawn (client only, never sent).
table RenderTuning {
  // Edge of a render chunk: a smaller one rebuilds faster after a build, a larger one draws in fewer calls.
  chunk_cells: int32 = 64 (min: 1, max: 1024, cli: "--render-chunk-cells");
}

table Settings {
  core: z13.fbs.core.CoreSettings;
  connect_timeout: ConnectTimeout;
  net: z13.fbs.net.NetTuning;
  physics: z13.fbs.physics.PhysicsTuning;
  building: z13.fbs.building.BuildingTuning;
  visual_smoothing: VisualSmoothing;
  render: RenderTuning;
}

root_type Settings;

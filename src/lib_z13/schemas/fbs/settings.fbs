include "building_tuning.fbs";
include "core_settings.fbs";
include "net_tuning.fbs";
include "physics_tuning.fbs";

// The game's settings.json, next to the input config.

namespace z13.fbs.settings;

table ConnectTimeout {
  limit: uint32 = 32 (min: 1, cli: "--connect-limit");
  min_timeout_ms: uint32 = 1000 (min: 1, cli: "--connect-min-timeout-ms");
  max_timeout_ms: uint32 = 3000 (min: 1, cli: "--connect-max-timeout-ms");
}

// How remote entities are drawn chasing their simulated pose (client only, never sent).
table VisualSmoothing {
  smooth_time_seconds: float = 0.1 (min: 0, max: 2, cli: "--visual-smooth-time");
  // A correction past either limit (a teleport, a resync) is drawn at once.
  snap_distance: float = 20 (min: 0, cli: "--visual-snap-distance");
  snap_angle_deg: float = 90 (min: 0, max: 180, cli: "--visual-snap-angle");
}

// How the station is drawn (client only, never sent).
table RenderTuning {
  // Edge of a render chunk: a smaller one rebuilds faster after a build, a larger one draws in fewer calls.
  chunk_cells: int32 = 64 (min: 1, max: 1024, cli: "--render-chunk-cells");
  // Rooms seen only through portals narrower than this on screen, in pixels, aren't drawn.
  min_portal_pixels: float = 2 (min: "0", max: "100", cli: "--render-min-portal-pixels");
  // Flashlights lit in a frame, the nearest first (Forward+, light_clusters.h); lamps are baked (cell_light).
  frame_lights: int32 = 128 (min: 1, max: 1024, cli: "--render-frame-lights");
  // A light cluster: its screen tile in pixels, the depth slices between near_m and far_m (even
  // in log(depth); nearer and farther fragments share the end slices), and the most lights it keeps.
  light_cluster_px: int32 = 128 (min: 16, max: 1024, cli: "--render-light-cluster-px");
  light_cluster_slices: int32 = 12 (min: 1, max: 64, cli: "--render-light-cluster-slices");
  light_cluster_near_m: float = 1 (min: "0.01", max: "100", cli: "--render-light-cluster-near");
  light_cluster_far_m: float = 200 (min: "1", max: "10000", cli: "--render-light-cluster-far");
  lights_per_cluster: int32 = 32 (min: 1, max: 256, cli: "--render-lights-per-cluster");
  // Shadow slots: the flashlights' first, then the lamps nearest the players, whose baked light a
  // player's shadow takes back (assets/shaders/lighting.fs).
  shadow_lights: int32 = 4 (min: 0, max: 32, cli: "--render-shadow-lights");
  // Edge of each face of a lamp's shadow cube, in pixels.
  shadow_map_size: int32 = 256 (min: 64, max: 512, cli: "--render-shadow-map-size");
  // Lights whose shadow is drawn anew per frame as they take a slot.
  shadow_updates_per_frame: int32 = 4 (min: 1, max: 32, cli: "--render-shadow-updates");
  // Edge of the sun's and the fill's shadow maps over the whole station, in pixels.
  sun_shadow_map_size: int32 = 4096 (min: 256, max: 8192, cli: "--render-sun-shadow-map-size");
  // Brightness of the dim fill that keeps the hull's shaded faces from going black.
  outside_fill: float = 0.25 (min: "0", max: "1", cli: "--render-outside-fill");
  // A player's flashlight: how far it reaches, in meters, half its cone's angle and its brightness.
  flashlight_range_m: float = 20 (min: "1", max: "100", cli: "--render-flashlight-range");
  flashlight_half_angle_deg: float = 35 (min: "5", max: "80", cli: "--render-flashlight-angle");
  flashlight_intensity: float = 1.5 (min: "0", max: "10", cli: "--render-flashlight-intensity");
}

// The touch controls' layout (client only, never sent; docs/android-plan.md). Sizes are fractions
// of the screen's height, positions fractions of its width (x) and height (y, from the top).
table TouchLayout {
  // Touches starting in this left part of the screen move (the floating stick), the rest look.
  stick_zone_width: float = 0.5 (min: "0.1", max: "0.9", cli: "--touch-stick-zone");
  // How far the finger goes from where it touched for full speed.
  stick_radius: float = 0.12 (min: "0.02", max: "0.5", cli: "--touch-stick-radius");
  // The part of stick_radius that doesn't move, so a resting finger's jitter sends no commands.
  stick_dead_zone: float = 0.15 (min: "0", max: "0.9", cli: "--touch-stick-dead-zone");
  // The stick's values move in these steps, each a command against the server's budget.
  stick_step: float = 0.25 (min: "0.01", max: "1", cli: "--touch-stick-step");
  // The turn a drag across the screen's height makes.
  look_degrees: float = 180 (min: "1", max: "1440", cli: "--touch-look-degrees");
  button_radius: float = 0.07 (min: "0.02", max: "0.25", cli: "--touch-button-radius");
  jump_x: float = 0.9 (min: "0", max: "1", cli: "--touch-jump-x");
  jump_y: float = 0.78 (min: "0", max: "1", cli: "--touch-jump-y");
  crouch_x: float = 0.78 (min: "0", max: "1", cli: "--touch-crouch-x");
  crouch_y: float = 0.88 (min: "0", max: "1", cli: "--touch-crouch-y");
  use_x: float = 0.9 (min: "0", max: "1", cli: "--touch-use-x");
  use_y: float = 0.52 (min: "0", max: "1", cli: "--touch-use-y");
  flashlight_x: float = 0.9 (min: "0", max: "1", cli: "--touch-flashlight-x");
  flashlight_y: float = 0.26 (min: "0", max: "1", cli: "--touch-flashlight-y");
  // The hotbar: a row of square cells centred at the bottom, on PC too.
  hotbar_y: float = 0.93 (min: "0", max: "1", cli: "--touch-hotbar-y");
  hotbar_cell_size: float = 0.09 (min: "0.02", max: "0.2", cli: "--touch-hotbar-cell-size");
  tool_mode_x: float = 0.78 (min: "0", max: "1", cli: "--touch-tool-mode-x");
  tool_mode_y: float = 0.66 (min: "0", max: "1", cli: "--touch-tool-mode-y");
}

// Finding servers on the LAN (client and server; docs/server-plan.md, "Поиск сервера").
table LanDiscovery {
  // The game's port plus one by default (lib_core's kDefaultServerPort).
  port: uint32 = 26214 (min: 1, max: 65535, cli: "--discovery-port");
  // Shown in other players' Join windows.
  server_name: string = "Zodiac13 server" (non_empty);
  // How often an open Join window asks again.
  query_interval_ms: uint32 = 1500 (min: 100, max: 60000, cli: "--discovery-query-interval");
  // A server answers one address at most this often: queries can't make it flood.
  reply_interval_ms: uint32 = 200 (min: 0, max: 60000, cli: "--discovery-reply-interval");
  // A server not heard from for this long leaves the Join window's list.
  forget_after_ms: uint32 = 5000 (min: 100, max: 600000, cli: "--discovery-forget-after");
}

table Settings {
  core: z13.fbs.core.CoreSettings;
  connect_timeout: ConnectTimeout;
  net: z13.fbs.net.NetTuning;
  physics: z13.fbs.physics.PhysicsTuning;
  building: z13.fbs.building.BuildingTuning;
  visual_smoothing: VisualSmoothing;
  render: RenderTuning;
  touch: TouchLayout;
  lan_discovery: LanDiscovery;
}

root_type Settings;

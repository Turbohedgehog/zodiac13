// The "building" table of settings.json, also what a server sends in Welcome.

include "attributes.fbs";

namespace z13.fbs.building;

table BuildingTuning {
  // How far along the player's forward axis a destroy raycast reaches, in meters.
  destroy_reach_distance: float = 5 (min: "0.01", cli);
  // How far along the player's forward axis "use" reaches, in meters.
  use_reach_distance: float = 2 (min: "0.01", cli);
  // Edge of the chunks the station's block index files blocks by.
  index_chunk_cells: int32 = 16 (min: 1, max: 1024, cli);
  // Edge of the chunks rooms cut the free space by: an edit rebuilds only its chunks.
  room_chunk_cells: int32 = 32 (min: 4, max: 1024, cli);
  // The widest a hole in a thin wall or floor may be, along either side, to split rooms as a
  // doorway rather than join them: a door's opening is 4 x 8.
  room_max_opening_cells: int32 = 16 (min: 1, max: 256, cli);
  // How far above a spawn marker's top players appear, in meters, so they drop onto it.
  spawn_height_above_marker: float = 1 (min: 0, cli);
  // Cells kept free above a spawn marker: past the head of a player at the spawn height.
  spawn_clearance_cells: int32 = 8 (min: 1, max: 64, cli);
  // The palette primitive a player's brush starts with: a wall panel.
  default_brush_type: uint32 = 2 (min: 1, cli);
  // Cells a picked primitive spans along each axis it stretches along, until a drag resizes it.
  default_brush_width_cells: int32 = 8 (min: 1, max: 256, cli);
  // How far, in cells, a wall's click snaps to an existing wall node or stick end.
  wall_snap_cells: float = 1.5 (min: "0", cli);
  // The thickest wall the wheel sets, in cells.
  wall_max_thickness_cells: int32 = 16 (min: 1, max: 256, cli);
}

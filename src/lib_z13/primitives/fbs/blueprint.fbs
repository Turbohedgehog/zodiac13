// A ready-made station (assets/station/blueprints/), placed block by block; see
// docs/station-primitives-plan.md. Written by docs/station-layout/generate_layout.py.

include "primitives.fbs";

namespace z13.fbs.station;

struct Cell {
  x: int;
  y: int;
  z: int;
}

// z13::station::Orientation, in the same order.
enum Orientation : ubyte {
  FacePosXUpPosZ,
  FacePosXUpNegZ,
  FacePosXUpPosY,
  FacePosXUpNegY,
  FaceNegXUpPosZ,
  FaceNegXUpNegZ,
  FaceNegXUpPosY,
  FaceNegXUpNegY,
  FacePosYUpPosZ,
  FacePosYUpNegZ,
  FacePosYUpPosX,
  FacePosYUpNegX,
  FaceNegYUpPosZ,
  FaceNegYUpNegZ,
  FaceNegYUpPosX,
  FaceNegYUpNegX,
  FacePosZUpPosX,
  FacePosZUpNegX,
  FacePosZUpPosY,
  FacePosZUpNegY,
  FaceNegZUpPosX,
  FaceNegZUpNegX,
  FaceNegZUpPosY,
  FaceNegZUpNegY,
}

table BlueprintBlock {
  // The palette entry's name: ids may differ between palettes, names are what a blueprint
  // is checked against.
  primitive: string;
  // The lowest corner of the cells the block occupies.
  cell: Cell;
  size: Cells;
  orientation: Orientation;
  // A panel's rise along its size's X; zero for other primitives.
  slant: ushort;
}

// z13::station::WallAxis, in the same order.
enum WallAxis : ubyte {
  X,
  Y,
  Z,
}

// z13::station::WallDiagonal, in the same order.
enum WallDiagonal : ubyte {
  BaseToTip,
  TipToBase,
}

// A wall segment (z13::station::WallSegment) between two nodes at the cells `node_a` and `node_b`;
// nodes at one cell are one node, so walls meeting there are stitched along a seam. Its panels are
// derived when the scene is placed, not listed among the blocks.
table BlueprintWall {
  node_a: Cell;
  node_b: Cell;
  axis_a: WallAxis = Z;
  length_a: int;
  axis_b: WallAxis = Z;
  length_b: int;
  thickness: int;
  diagonal: WallDiagonal;
}

table Blueprint {
  blocks: [BlueprintBlock];
  walls: [BlueprintWall];
}

root_type Blueprint;

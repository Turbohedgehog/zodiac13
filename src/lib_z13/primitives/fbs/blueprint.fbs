// A ready-made station (assets/station/blueprints/), placed block by block; see
// docs/station-primitives-plan.md. Written by docs/station-layout/generate_layout.py.

include "primitives.fbs";

namespace z13.fbs.station;

struct Cell {
  x: int;
  y: int;
  z: int;
}

// z13::station::Orientation, in the same order.
enum Orientation : ubyte {
  FacePosXUpPosZ,
  FacePosXUpNegZ,
  FacePosXUpPosY,
  FacePosXUpNegY,
  FaceNegXUpPosZ,
  FaceNegXUpNegZ,
  FaceNegXUpPosY,
  FaceNegXUpNegY,
  FacePosYUpPosZ,
  FacePosYUpNegZ,
  FacePosYUpPosX,
  FacePosYUpNegX,
  FaceNegYUpPosZ,
  FaceNegYUpNegZ,
  FaceNegYUpPosX,
  FaceNegYUpNegX,
  FacePosZUpPosX,
  FacePosZUpNegX,
  FacePosZUpPosY,
  FacePosZUpNegY,
  FaceNegZUpPosX,
  FaceNegZUpNegX,
  FaceNegZUpPosY,
  FaceNegZUpNegY,
}

table BlueprintBlock {
  // The palette entry's name: ids may differ between palettes, names are what a blueprint
  // is checked against.
  primitive: string;
  // The lowest corner of the cells the block occupies.
  cell: Cell;
  size: Cells;
  orientation: Orientation;
  // A panel's rise along its size's X; zero for other primitives.
  slant: ushort;
}

// z13::station::WallAxis, in the same order.
enum WallAxis : ubyte {
  X,
  Y,
  Z,
}

// z13::station::WallDiagonal, in the same order.
enum WallDiagonal : ubyte {
  BaseToTip,
  TipToBase,
}

// z13::station::OpeningKind, in the same order.
enum OpeningKind : ubyte {
  Door,
  Window,
  Passage,
}

// A gap in a wall (z13::station::WallOpening): `offset` and `width` in wall steps from node a, `sill`
// and `height` in cells up the stick.
table BlueprintWallOpening {
  kind: OpeningKind;
  offset: int;
  width: int;
  sill: int;
  height: int;
}

// A wall segment (z13::station::WallSegment) between two nodes at the cells `node_a` and `node_b`;
// nodes at one cell are one node, so walls meeting there are stitched along a seam. Its panels are
// derived when the scene is placed, not listed among the blocks.
table BlueprintWall {
  node_a: Cell;
  node_b: Cell;
  axis_a: WallAxis = Z;
  length_a: int;
  axis_b: WallAxis = Z;
  length_b: int;
  thickness: int;
  diagonal: WallDiagonal;
  openings: [BlueprintWallOpening];
}

// A district beside the main grid (docs/multi-grid-plan.md): built in its own cells, set in the world by its pose.
// `id` is not zero (the main grid's) and unique.
table BlueprintGrid {
  id: uint;
  origin: Cell;
  yaw_degrees: float;
  pitch_degrees: float;
  blocks: [BlueprintBlock];
  walls: [BlueprintWall];
}

// A z13::station::Dock.
table BlueprintDock {
  a_grid: uint;
  a_cell: Cell;
  b_grid: uint;
  b_cell: Cell;
}

// A run of conduit (z13::conduit::Conduit) by the name of its kind (assets/station/conduits.json), in the cells of
// `grid`; `axis` as a wall's.
table BlueprintConduit {
  grid: uint;
  kind: string;
  cell: Cell;
  axis: WallAxis = Z;
  length: int;
}

// A z13::station::Lift with its cabin, a box of the named palette primitive `size` cells large; `lower` and `upper` are
// the cells its lowest corner stands at, the buttons cells of the main grid.
table BlueprintLift {
  primitive: string;
  size: Cell;
  lower: Cell;
  upper: Cell;
  lower_button: Cell;
  upper_button: Cell;
  trip_ticks: uint;
}

// A z13::inventory::AccessLock: the block at `cell` of grid `grid` (0 is the main grid's) needs all of the accesses
// in `required_all` and, when `required_any` names any, one of them. The names are z13::inventory::AccessName's.
table BlueprintLock {
  grid: uint;
  cell: Cell;
  required_all: [string];
  required_any: [string];
}

table Blueprint {
  blocks: [BlueprintBlock];
  walls: [BlueprintWall];
  grids: [BlueprintGrid];
  docks: [BlueprintDock];
  conduits: [BlueprintConduit];
  lifts: [BlueprintLift];
  locks: [BlueprintLock];
  doors_open: bool;
}

root_type Blueprint;

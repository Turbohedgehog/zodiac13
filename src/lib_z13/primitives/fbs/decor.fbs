// The props of a station (assets/station/decor/<scene>.json): models placed over its blocks for
// rendering only; the server never reads them. Written by docs/station-layout/generate_octant.py.

namespace z13.fbs.station;

// Meters, Z up, like the blueprint's cells.
struct Position {
  x: float;
  y: float;
  z: float;
}

table DecorProp {
  // A file name in assets/models/props/ without its extension.
  model: string;
  position: Position;
  // Radians about Z, applied after the pitch.
  yaw: float;
  // Radians about X first: a model made to hang on a wall turns to hang from a ceiling.
  pitch: float;
}

table Decor {
  props: [DecorProp];
  // Palette primitives whose blocks are not drawn because props stand in for them (lamps).
  replaces: [string];
}

root_type Decor;

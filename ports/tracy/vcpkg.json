{
  "name": "tracy",
  "version": "0.13.1",
  "port-version": 1,
  "description": "Tracy profiler client, shared (zodiac13 overlay: no tools).",
  "homepage": "https://github.com/wolfpld/tracy",
  "license": "BSD-3-Clause",
  "supports": "!(windows & (arm | uwp))",
  "dependencies": [
    {
      "name": "pthreads",
      "platform": "!windows"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "crash-handler"
  ],
  "features": {
    "crash-handler": {
      "description": "Enable crash handler"
    },
    "on-demand": {
      "description": "Enable on-demand profiling"
    }
  }
}

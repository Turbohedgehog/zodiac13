name: Build with vcpkg and CMake for Ubuntu

on: [push, pull_request]

jobs:
  build:
    runs-on: ubuntu-latest # Or windows-latest, macos-latest, ubuntu-latest
    permissions: write-all

    steps:
    - uses: actions/checkout@v4

    - name: Enable GitHub Actions Cache backend
      uses: actions/github-script@v7
      with:
        script: |
          core.exportVariable('ACTIONS_CACHE_URL', process.env.ACTIONS_CACHE_URL || '');
          core.exportVariable('ACTIONS_RUNTIME_TOKEN', process.env.ACTIONS_RUNTIME_TOKEN || '');

    - name: Install and build with vcpkg
      uses: johnwason/vcpkg-action@v6
      with:
        vcpkgJsonPath: 'vcpkg.json' # If using manifest mode
        # Other vcpkg-action parameters as needed
      env:
        VCPKG_BINARY_SOURCES: 'clear;x-gha,readwrite'
        VCPKG_FEATURE_FLAGS: 'dependencygraph' # For dependency graph integration
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }} # For dependency graph integration

    - run: cmake .
      env:
        VCPKG_BINARY_SOURCES: "clear;x-gha,readwrite"
        VCPKG_ROOT: "${{ github.workspace }}/vcpkg"
    - run : cmake --build .
    - run : cmake --build . --target package

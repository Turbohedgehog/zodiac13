name: Build with vcpkg and CMake for Windows

on: [push, pull_request]

jobs:
  build:
    runs-on: windows-latest # Or windows-latest, macos-latest, ubuntu-latest
    permissions: write-all

    steps:
    - uses: actions/checkout@v4

    - name: Setup vcpkg
      uses: lukka/run-vcpkg@v11 # Or johnwason/vcpkg-action@v5
      with:
        vcpkgDirectory: '${{ github.workspace }}/vcpkg'
        # Optional: Specify a vcpkg.json manifest if you're using manifest mode
        # vcpkgJsonPath: '${{ github.workspace }}/vcpkg.json' 
        # Optional: Define VCPKG_DEFAULT_TRIPLET if not using default
        # VCPKG_DEFAULT_TRIPLET: x64-linux-static 
    - run: cmake .
      env:
        VCPKG_BINARY_SOURCES: "clear;x-gha,readwrite"
        VCPKG_ROOT: "${{ github.workspace }}/vcpkg"
    - run : cmake --build .
    - run : cmake --build . --target package
